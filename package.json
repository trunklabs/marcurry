  "devDependencies": {
    "@changesets/cli": "2.29.8",
    "husky": "9.1.7",
    "prettier": "3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "turbo": "2.7.5",
    "vitest": "4.0.18"
  }
